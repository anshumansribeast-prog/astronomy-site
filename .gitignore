# ===================================================================
# Astronomy site — mostly static, with a small Node server for
# accounts. Almost nothing needs ignoring, and that is a good sign.
# ===================================================================

# Secrets
.env
.env.local

# The account/session database — real people's data, never committed.
# Schema (server/db/schema.sql) is tracked; the data it produces isn't.
/data/
*.db
*.db-shm
*.db-wal

# Netlify's local link file — keeps deploys from silently retargeting.
.netlify/

# Logs
*.log

# Editors
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db
desktop.ini
