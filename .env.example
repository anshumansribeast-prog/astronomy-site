# Cosmos server configuration template — never commit real secrets.
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Optional second-opinion fallback. It is only called when Beast's primary
# model signals genuine uncertainty or the primary provider fails.
BEAST_FALLBACK_API_URL=
BEAST_FALLBACK_API_KEY=
BEAST_FALLBACK_MODEL=

# Existing Cosmos configuration continues below.
NASA_API_KEY=DEMO_KEY
ASTRO_DATA_DIR=/app/data
PORT=8899
