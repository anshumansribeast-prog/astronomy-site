new file mode 100755
index 0000000..98e5192
--- /dev/null
+++ b/docker-entrypoint.sh
@@ -0,0 +1,8 @@
+#!/bin/sh
+set -eu
+
+# Ada's Python bridge talks to Ollama on this machine. With host networking
+# (recommended on punah.pro), 127.0.0.1 reaches the host's Ollama. Override
+# with OLLAMA_URL when Ollama runs elsewhere.
+python3 /opt/semicolon/ada_server.py &
+exec nginx -g 'daemon off;'
