+++ b/.cursor/scripts/start.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+PORT="${PORT:-8080}"
+
+if curl -fsS "http://127.0.0.1:${PORT}/api/ada/health" >/dev/null 2>&1; then
+  echo "Semicolon already running on port ${PORT}"
+  exit 0
+fi
+
+docker rm -f semicolon-dev >/dev/null 2>&1 || true
+docker run -d --name semicolon-dev -p "${PORT}:80" semicolon:dev
+
+for _ in $(seq 1 20); do
+  if curl -fsS "http://127.0.0.1:${PORT}/api/ada/health" >/dev/null 2>&1; then
+    echo "Semicolon ready on port ${PORT}"
+    exit 0
+  fi
+  sleep 1
+done
+
+echo "Semicolon failed to start within 20s" >&2
+docker logs semicolon-dev >&2 || true
+exit 1
