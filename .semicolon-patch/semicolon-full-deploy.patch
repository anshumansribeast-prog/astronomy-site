+          # Ada's API bridge should be up even when Ollama is not (CI has no model).
+          code=$(curl -s -o /dev/null -w "%{http_code}" -X OPTIONS http://localhost:8080/api/ada)
+          echo "OPTIONS /api/ada -> ${code}"
+          [ "$code" = "204" ] || { echo "::error::Ada OPTIONS failed"; docker logs semicolon; exit 1; }
