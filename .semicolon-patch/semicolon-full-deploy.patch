+#!/usr/bin/env bash
+set -euo pipefail
+
+# Idempotent bootstrap for semicolon. Static site + Ada Python bridge in Docker.
+if ! command -v docker >/dev/null 2>&1; then
+  echo "Docker is required for local smoke tests (CI uses the same image build)."
+  exit 1
+fi
+
+if ! docker info >/dev/null 2>&1; then
+  echo "Docker daemon is not running. Start dockerd before building the image."
+  exit 1
+fi
+
+docker build -t semicolon:dev .
